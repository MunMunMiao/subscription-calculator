# Copy to `.dev.vars` for local Wrangler/Vite (Cloudflare secrets).
# Do not commit real values.

# Used as better-auth `baseURL`. Must match the origin you open in the browser.
# Local default is also set in wrangler.jsonc vars.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# GitHub OAuth App (Authorization callback URL):
#   http://localhost:3000/api/auth/callback/github
#   https://orbit.lyz.cloud/api/auth/callback/github
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Optional: used by drizzle-kit if you generate/apply migrations over D1 HTTP.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
