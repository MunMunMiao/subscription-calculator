{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-calculator",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subscription-calculator",
      "database_id": "2200c603-924c-48a2-a8c0-e4b9a47e83da",
      "migrations_dir": "drizzle",
    },
  ],
  "routes": [{ "pattern": "orbit.lyz.cloud", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "BETTER_AUTH_URL": "https://orbit.lyz.cloud",
  },
  // Previews do not inherit production routes or D1. Do not put
  // orbit.lyz.cloud here — Previews are workers.dev URLs via `wrangler preview`.
  "previews": {
    "vars": {
      "BETTER_AUTH_URL": "https://preview.invalid",
      "TECHO_PREVIEW": "1",
    },
    "define": {
      "import.meta.env.VITE_TECHO_E2E": "\"1\"",
    },
  },
}
