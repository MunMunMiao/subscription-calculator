{
  "name": "subscription-calculator",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply subscription-calculator --local",
    "db:migrate:remote": "wrangler d1 migrations apply subscription-calculator --remote",
    "lint": "oxlint",
    "fmt": "bun fmt --no-script",
    "check": "bun check --no-script",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --coverage"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss",
    "unrs-resolver",
    "workerd"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.67.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.156.2"
  }
}
